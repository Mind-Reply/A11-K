# Sofia Tech Ledger — Development environment
# Copy to .env.local and fill in your credentials

NODE_ENV=development
PORT=8080
STL_OUT_DIR=./output

# Optional: Enable live data sources
# STL_LIVE=1
# STL_LIVE_EUROSTAT=1
# STL_LIVE_EGOV=1

# Optional: Google AI / Gemini configuration
# Use either API Key OR Vertex AI credentials (not both)

# Path 1: API Key (simplest, public API)
# GOOGLE_API_KEY=your-api-key-here

# Path 2: Vertex AI (enterprise, via ADC)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=europe-west1
# GOOGLE_GENAI_USE_ENTERPRISE=true
