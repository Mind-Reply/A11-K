<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>A11-K — Pro Security &amp; Web Filter v2</string>
    <key>PayloadDescription</key>
    <string>Owner-controlled security profile for iPhone. No Wi-Fi credentials are embedded.</string>
    <key>PayloadIdentifier</key>
    <string>space.a11-k.iphone14pro.security-v2</string>
    <key>PayloadOrganization</key>
    <string>A11-K</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>2B6D5C44-6D64-4A6C-9C8A-9F2F0E4C7A11</string>
    <key>PayloadVersion</key>
    <integer>2</integer>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadDisplayName</key><string>Security Restrictions</string>
            <key>PayloadIdentifier</key><string>space.a11-k.iphone14pro.security-v2.restrictions</string>
            <key>PayloadType</key><string>com.apple.applicationaccess</string>
            <key>PayloadUUID</key><string>0B5D0D7B-1A11-4C74-9C45-6E5B6F2E9A01</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>allowAssistantWhileLocked</key><false/>
            <key>allowControlCenterWhileLocked</key><false/>
            <key>allowScreenShot</key><true/>
            <key>allowUntrustedTLSPrompt</key><false/>
        </dict>
        <dict>
            <key>PayloadDisplayName</key><string>Passcode Policy</string>
            <key>PayloadIdentifier</key><string>space.a11-k.iphone14pro.security-v2.passcode</string>
            <key>PayloadType</key><string>com.apple.mobiledevice.passwordpolicy</string>
            <key>PayloadUUID</key><string>7A4B9D21-2C8E-4F67-AB93-18E0D5C6F202</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>forcePIN</key><true/>
            <key>minLength</key><integer>6</integer>
            <key>requireAlphanumeric</key><true/>
            <key>maxFailedAttempts</key><integer>10</integer>
            <key>maxGracePeriod</key><integer>0</integer>
            <key>maxInactivityTime</key><integer>300</integer>
        </dict>
        <dict>
            <key>PayloadDisplayName</key><string>Built-in Web Content Filter</string>
            <key>PayloadIdentifier</key><string>space.a11-k.iphone14pro.security-v2.webfilter</string>
            <key>PayloadType</key><string>com.apple.webcontent-filter</string>
            <key>PayloadUUID</key><string>4C8E1F53-7B2A-4D96-AE31-5F9C0B7D3303</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>FilterType</key><string>BuiltIn</string>
            <key>AutoFilterEnabled</key><true/>
            <key>PermittedURLs</key><array><string>https://apple.com</string><string>https://developer.apple.com</string><string>https://mind-reply.com</string><string>https://a11-k.space</string></array>
            <key>SafariHistoryRetentionEnabled</key><true/>
        </dict>
    </array>
</dict>
</plist>